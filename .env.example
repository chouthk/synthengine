# SynthEngine — Core Configuration
# ============================================
# 1. LLM API Key (DeepSeek recommended for HK)
DEEPSEEK_API_KEY=***

# 2. SiliconFlow (alternative to DeepSeek)
# SILICONFLOW_API_KEY=***

# 3. OpenAI compatible (if using other providers)
# OPENAI_API_KEY=***
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 4. Cloud GPU (RunPod / Vast.ai)
CLOUD_GPU_SERVER_IP=your_pod_ip
CLOUD_GPU_SSH_PORT=2222

# 5. Data pipeline
OUTPUT_DIR=./data/raw
COMPRESSED_DIR=./data/compressed
SCENARIO_CONFIG=./config/scenarios.yaml
BATCH_SIZE=100
MAX_RETRIES=3

# 6. Environment
ENV_STATUS=development
