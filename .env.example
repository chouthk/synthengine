# SynthEngine — Core Configuration
# ============================================

# 1. LLM API Key (DeepSeek)
DEEPSEEK_API_KEY=

# 2. OpenAI compatible endpoint
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 3. Output config
OUTPUT_DIR=./data/raw
MAX_RETRIES=3

# 4. Environment
ENV_STATUS=development
